{
  "rewrites": [
    {
      "source": "/:shortId((?!shorten|statistics|settings|inactive)[\\w\\-]{1,})",
      "has": [
        {
          "type": "host",
          "value": "easurl.xyz"
        }
      ],
      "destination": "https://easyurl-eymh.onrender.com/:shortId"
    },
    {
      "source": "/api/:match*",
      "destination": "https://easyurl-eymh.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
